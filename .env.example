# MongoDB Connection (Change to your MongoDB URI)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/Portfolio?appName=Portfolio

# Server Configuration
PORT=3001

# Admin Panel Password
ADMIN_PASSWORD=your_secure_password_here

# Frontend URL (for CORS - where your frontend is hosted)
FRONTEND_URL=http://localhost:5173

# API URL for frontend (Vite requires VITE_ prefix - where your backend is hosted)
VITE_API_URL=http://localhost:3001

# Gemini API Key (For AI features, get from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
